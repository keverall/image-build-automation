# === Core Dependencies ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.python-version

# === Virtual Environments & Rust Tooling (uv) ===
.venv/
venv/
ENV/
env/
.uv/

# === Local Automation Runners (just) ===
.just/
.task/

# === IDEs & Workspaces ===
.vscode/
.idea/
*.swp
*.swo
node_modules/

# === Logs, Reports & Linters ===
htmlcov/
build_reports/
.ruff_cache/

# === Generated Output (build artifacts) ===
# Keep directory placeholders, not runtime audit data, logs, reports or images.
# Re-include directories so Git can reach nested .gitkeep files.
# Reviewed documentation under docs/ remains trackable.
/generated/**
!/generated/**/
!/generated/**/.gitkeep

# === Configuration Secrets ===
configs/opsramp_config.json
configs/hpe_firmware_drivers_nov2025.json
configs/windows_patches.json

# === Windows Binaries & Build Images ===
tools/hpe_sut.exe
tools/dism.exe
*.tmp
*.bak

# ISO images are distributed through the approved artifact channel, not Git.
*.iso

# === OS Generated Files ===
.DS_Store
Thumbs.db



# === AI Workspace Configs ===
.kilo/
AGENTS.md
/scripts/modules/OperationsManager/

/scripts/modules/
/scripts/modules/*

# Keep the vendored HPRESTCmdlets package trackable while ignoring other local
# PowerShell module installations. Every ignored parent must be re-included so
# Git can descend to the files below it.
!/scripts/modules/
!/scripts/modules/HPRESTCmdlets/
/scripts/modules/HPRESTCmdlets/*
!/scripts/modules/HPRESTCmdlets/1.2.0.0/
!/scripts/modules/HPRESTCmdlets/1.2.0.0/**

# === Offline PowerShell Dependencies ===
# Only approved, version-pinned packages are distributed through Git.
# These exceptions must follow generic dependency rules such as lib/ above.
# Preserve vendor manifests, DLLs, format/type XML, help, examples and licenses.
/scripts/modules/*
!/scripts/modules/HPRESTCmdlets/
/scripts/modules/HPRESTCmdlets/*
!/scripts/modules/HPRESTCmdlets/1.2.0.0/
!/scripts/modules/HPRESTCmdlets/1.2.0.0/**
!/scripts/modules/HPEOneView.1000/
/scripts/modules/HPEOneView.1000/*
!/scripts/modules/HPEOneView.1000/10.0.4265.2221/
!/scripts/modules/HPEOneView.1000/10.0.4265.2221/**

# ---- POWERSHELL RUNTIME & LOGGING ----
# Also exclude operational files accidentally placed inside vendor packages.
*.log
*_transcript.*
.ps_history

# ---- TESTING & COVERAGE ----
# Block Pester testing framework artifacts
**/TestResults/
*TestResults.xml

/packages/

# ---- SECRETS & SCRIPTS ----
# Keep security exclusions AFTER the vendor allowlist so secrets stay blocked.
# Block private configurations or local profiles
secret.*
config.private.*
.env
.env.*
secrets.env

# ---- CRYPTOGRAPHIC MATERIAL (never commit) ----
# Private keys and certificate stores. Gitleaks + scripts/secret-scan.ps1
# detect these in content; these patterns stop the files being staged at all.
*.pem
*.key
*.pfx
*.p12
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts
# Scanner output / local suppression files (not the committed allowlist).
secret-scan-report.json
secret-scan-code-quality.json
*.secret-scan.bak

# Local scratch workspace: purged from git history (see docs/compliance/SECRET_SCANNING.md).
/wip/*
!/wip/testing-issue.md
# Generated Word/RTF mirrors of wip/ scratch (same content, binary). Kept out
# of git so scratch material - including any embedded SSH keys - cannot be
# re-committed via `make word-docs`.
/docx/wip/
/docs/rtf/wip/
/doc/windows/help/rtf/wip/
