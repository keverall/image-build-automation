\pard\sa120\sb120\fs28\b Connectivity, Connection & Server Lookup\b0{\*\bkmkstart connectivity-connection-server-lookup}{\*\bkmkend connectivity-connection-server-lookup}\par
\pard\sa80\fs22 Pre-flight read-only checks. Safe to run during a change freeze. Start here - confirm the appliance is reachable, that you have an active session, and which servers are managed before you build or deploy anything.\par
\pard\sa120\sb120\fs24\b Test OneView connectivity\b0{\*\bkmkstart test-oneview-connectivity}{\*\bkmkend test-oneview-connectivity}\par
\pard\sa80\fs22 Read-only connectivity STATUS CHECK for a OneView appliance. \b This command never prompts for a host or credentials.\b0\par
\pard\li360\fi-360\fs22\'95\tab \b No parameters\b0 -> reports the active {\f1 Connect-OneView\f0} session (if any).\par\pard\li360\fi-360\fs22\'95\tab \b {\f1 -OneViewHost\f0} supplied\b0 -> checks that specific appliance only.\par
\pard\sa80\fs22 Reachability probes DNS/TCP; authentication reuses the active session (when it matches) or uses {\f1 -Credential\f0} / {\f1 ONEVIEW_USER\f0} + {\f1 ONEVIEW_PASSWORD\f0}. It never asks for a username or password.\par
\pard\sa80\fs22 \b To actually connect\b0, use {\f1 Connect-OneView -OneViewHost <host>\f0} (which prompts for credentials and establishes the session this command reports on).\par
\pard\sa80\fs22 \b The OneView session established by {\f1 Connect-OneView\f0} persists in the current PowerShell session.\b0 Use {\f1 Disconnect-OneView\f0} to explicitly close the session when finished.\par
{\pard\sa80\sb80\fs20\fi0\brdrt\brdrs\brdrw10\brdrb\brdrs\brdrw10\clcbpat2\cf2{\f1 # STATUS: report the active connection (no params, no prompt)Test-ServerConnectivity\f0}\par}
{\pard\sa80\sb80\fs20\fi0\brdrt\brdrs\brdrw10\brdrb\brdrs\brdrw10\clcbpat2\cf2{\f1 # STATUS: check a specific appliance onlyTest-ServerConnectivity -OneViewHost oneview.example.com\f0}\par}
{\pard\sa80\sb80\fs20\fi0\brdrt\brdrs\brdrw10\brdrb\brdrs\brdrw10\clcbpat2\cf2{\f1 # DRY-RUN: validate host resolution only - no real connection or changesTest-ServerConnectivity -OneViewHost oneview.example.com -DryRun\f0}\par}
\pard\sa80\fs22 \b Parameters:\b0\par
\trowd\trgaph60\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx3008\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx6016\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx9024{\pard\fi0\li60\ri60\fs22\sa40\sb40 \clcbpat3 \b \b0 Parameter\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 \clcbpat3 \b \b0 Required\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 \clcbpat3 \b \b0 Description\cell}\row\trowd\trgaph60\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx3008\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx6016\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx9024{\pard\fi0\li60\ri60\fs22\sa40\sb40 {\f1 -OneViewHost\f0}\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 No\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 OneView appliance to check (server name or IP). Omit to report the active {\f1 Connect-OneView\f0} session; supply to check a specific appliance verbatim (no config/env fallback).\cell}\row\trowd\trgaph60\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx3008\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx6016\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx9024{\pard\fi0\li60\ri60\fs22\sa40\sb40 {\f1 -Credential\f0}\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 No\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 {\f1 PSCredential\f0} for authentication. Only used when {\f1 -OneViewHost\f0} is supplied and the active session does not match.\cell}\row\trowd\trgaph60\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx3008\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx6016\clbrdrt\brdrs\clbrdrl\brdrs\clbrdrb\brdrs\clbrdrr\brdrs\cellx9024{\pard\fi0\li60\ri60\fs22\sa40\sb40 {\f1 -DryRun\f0}\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 No\cell}{\pard\fi0\li60\ri60\fs22\sa40\sb40 Return mock data; config may be read.\cell}\row
\pard\sa80\fs22 No host is required - without one the command reports the active connection.\par
\pard\sa80\fs22 \b Returns:\b0 {\f1 [hashtable]\f0} with {\f1 Available\f0}, {\f1 Mode\f0} ({\f1 oneview\f0}), {\f1 OneViewHost\f0}, {\f1 NetworkPing\f0}, {\f1 AuthConnect\f0}, and {\f1 Timestamp\f0}.\par
\pard\sa80\fs22 \b Note:\b0 The OneView session persists after a successful connection. Use {\f1 Disconnect-OneView\f0} to close it.\par
\pard\brdrb\brdrs\brdrw20\brsp20\sa120\sb120\par
\pard\sa120\sb120\fs24\b Connect to OneView\b0{\*\bkmkstart connect-to-oneview}{\*\bkmkend connect-to-oneview}\par
\pard\sa80\fs22 Establishes a persistent OneView session by validating network reachability and authenticating to the appliance. After connecting, subsequent commands ({\f1 Get-OneViewServerList\f0}, {\f1 Get-OneViewConnectionStatus\f0}, etc.) reuse this session automatically.\par
\pard\sa80\fs22 On a live run the appliance host is taken verbatim from {\f1 -OneViewHost\f0} and credentials are entered interactively at the prompt. Config files are read \b only\b0 with {\f1 -DryRun\f0} (no real connection is made).\par
{\pard\sa80\sb80\fs20\fi0\brdrt\brdrs\brdrw10\brdrb\brdrs\brdrw10\clcbpat2\cf2{\f1 # LIVE: connect to a specific appliance (credentials prompted interactively)Connect-OneView -OneViewHost oneview.example.com\f0}\par}
{\pard\sa80\sb80\fs20\fi0\brdrt\brdrs\brdrw10\brdrb\brdrs\brdrw10\clcbpat2\cf2{\f1 # LIVE + NON-INTERACTIVE: supply a PSCredential so nothing is prompted# (used by runbooks / CI where AUTOMATED_MODE is set)$cred = Get-CredentialConnect-OneView -OneViewHost oneview.example.com -Credential $cred\f0}\par}
{\pard\sa80\sb80\fs20\fi0\brdrt\brdrs\brdrw10\brdrb\brdrs\brdrw10\clcbpat2\cf2{\f1 # BARE (no params) on a live run: prompts for the appliance host (interactive)# or warns "Connect-OneView requires -OneViewHost" in automated mode.Connect-OneView\f0}\par}
{\pard\sa80\sb80\fs20\fi0\brdrt\brdrs\brdrw10\brdrb\brdrs\brdrw10\clcbpat2\cf2{\f1 # DRY-RUN (no host): resolve the appliance from connection_hosts.json and# validate host resolution only - no real connection or changes.Connect-OneView -DryRun\f0}\par}
\pard\li360\ri360\sa80\fs22\i \b Why two commands?\b0 {\f1 Test-ServerConnectivity\f0} is a status check that \b never prompts\b0. {\f1 Connect-OneView\f0} is the command that \b does\b0 prompt for credentials and establishes the session. Use {\f1 Test-ServerConnectivity\f0} when you just want to check status; use {\f1 Connect-OneView\f0} when you need an active session for subsequent commands.\i0\par
\pard\sa80\fs22 \b Parameters:\b0\par
